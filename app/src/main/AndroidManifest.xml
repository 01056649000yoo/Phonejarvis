<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 개인정보 보호: 라이브러리가 인터넷 권한을 끼워 넣어도 제거. 이 앱은 완전 오프라인. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- 자동 브리핑: 정해진 시각 알람, 재부팅 후 재등록, 백그라운드 요약 실행, 결과 알림 -->
    <!-- 정한 시각 알람은 사용자가 켜는 '알람 및 리마인더'(SCHEDULE_EXACT_ALARM)만 — USE_EXACT_ALARM 은 Play 정책상 알람·캘린더 앱 전용이라 뺌(2026-11-22) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 수업 중·퇴근 모드에서 소리까지 끄기 (방해 금지, 선생님이 설정에서 허용할 때만) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- '모든 파일 접근'(MANAGE_EXTERNAL_STORAGE)은 쓰지 않음(2026-11-22 Play 스토어 준비) — 모델·백업은 파일 고르기, 자동 백업은 MediaStore.
         라이브러리가 끼워 넣어도 제거 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />

    <!-- 알림 앱 정리: 이 메시지 앱들이 설치돼 있는지만 확인 (알림이 0건일 때 안내하려고) -->
    <queries>
        <package android:name="com.kakao.talk" />
        <package android:name="com.samsung.android.messaging" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.nhn.android.band" />
        <package android:name="jp.naver.line.android" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.microsoft.teams" />
        <!-- 예전 쌤톡스(패키지 이름이 com.jarvis.phone 이던 판)가 남아 있는지 — 옮긴 뒤 지우도록 안내(2026-11-25) -->
        <package android:name="com.jarvis.phone" />
        <!-- ＋ 앱 추가: 홈 화면에 보이는 앱 목록 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- LiteRT-LM GPU 백엔드용 네이티브 라이브러리 -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 📥 카톡·드라이브·메일에서 받은 쌤톡스_백업.json 열기 → 설정 불러오기 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- 모든 앱의 알림을 수집하는 서비스 -->
        <service
            android:name=".NotificationCollectorService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 자동 브리핑: 온디바이스 LLM으로 알림 요약 (수 분 걸릴 수 있음) -->
        <service
            android:name=".BriefingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device LLM summarization of collected notifications at a user-scheduled time" />
        </service>

        <!-- 📤 다른 폰으로 보내기: 백업 파일을 공유 창으로 넘길 때만 사용 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 수업 시작·끝, 출근·퇴근 시각에 깨어나 수업 중·퇴근 모드 반영 -->
        <receiver android:name=".QuietReceiver" android:exported="false" />

        <receiver
            android:name=".BriefingReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- '알람 및 리마인더'를 켜면 정확한 시각으로 다시 예약 -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 🏠 홈 화면 위젯: 최근 요약 + [요약]·[⚙️] -->
        <receiver
            android:name=".SummaryWidgetReceiver"
            android:exported="true"
            android:label="쌤톡스 요약">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/summary_widget_info" />
        </receiver>
    </application>
</manifest>
